# uv-managed Python project: sync dependencies and activate the virtualenv.
# See https://docs.astral.sh/uv/ and https://direnv.net/

if ! has uv; then
    log_error "uv not found. Install it from https://docs.astral.sh/uv/"
    return 1
fi

watch_file pyproject.toml
watch_file uv.lock

uv sync --frozen
source .venv/bin/activate
